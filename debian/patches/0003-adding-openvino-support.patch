diff --git a/openvino.sh b/openvino.sh
new file mode 100755
index 0000000..0e0162e
--- /dev/null
+++ b/openvino.sh
@@ -0,0 +1,65 @@
+#!/bin/bash
+
+# sudo apt install python3-pip python3-pip-whl python3-setuptools python3-setuptools-whl python3-venv python3-wheel python3.12-venv ocl-icd-opencl-dev
+CURRENT_DIR=$PWD
+BASE_DIR="/tmp/openvino"
+rm -rf $BASE_DIR
+mkdir -p $BASE_DIR
+cd $BASE_DIR
+mkdir openvino_toolkit
+cd openvino_toolkit
+wget https://storage.openvinotoolkit.org/repositories/openvino/packages/2024.6/linux/l_openvino_toolkit_ubuntu22_2024.6.0.17404.4c0f47d2335_x86_64.tgz
+tar xvf l_openvino_toolkit_ubuntu22_2024.6.0.17404.4c0f47d2335_x86_64.tgz
+
+cd l_openvino_toolkit_ubuntu22_2024.6.0.17404.4c0f47d2335_x86_64
+OPENVIVO_TOOLKIT_DIR=$PWD
+
+wget https://storage.openvinotoolkit.org/repositories/openvino_tokenizers/packages/2024.6.0.0/openvino_tokenizers_ubuntu22_2024.6.0.0_x86_64.tar.gz
+tar xzvf openvino_tokenizers_ubuntu22_2024.6.0.0_x86_64.tar.gz
+
+cd ..
+cd ..
+
+mkdir libtorch
+cd libtorch
+wget https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.4.1%2Bcpu.zip
+unzip libtorch-cxx11-abi-shared-with-deps-2.4.1+cpu.zip
+LIBTORCH_DIR=$PWD/libtorch
+
+cd ..
+
+
+git clone https://github.com/ggerganov/whisper.cpp
+cd whisper.cpp
+git checkout v1.5.4
+cd ..
+mkdir whisper-build
+cd whisper-build
+
+source $OPENVIVO_TOOLKIT_DIR/setupvars.sh
+export LIBTORCH_ROOTDIR=$LIBTORCH_DIR
+
+cmake ../whisper.cpp/ -DWHISPER_OPENVINO=ON
+make -j 4
+cmake --install . --config Release --prefix ./installed
+WHISPER_BUILD_DIR=$PWD
+cd ..
+echo $PWD
+git clone https://github.com/intel/openvino-plugins-ai-audacity.git
+ls openvino-plugins-ai-audacity/
+echo $CURRENT_DIR
+cp -r openvino-plugins-ai-audacity/mod-openvino $CURRENT_DIR/modules
+cp $CURRENT_DIR/CMakeLists.txt.mod-openvino $CURRENT_DIR/modules/mod-openvino/CMakeLists.txt
+cp $CURRENT_DIR/CMakeLists.txt.modules $CURRENT_DIR/modules/CMakeLists.txt
+
+source $OPENVIVO_TOOLKIT_DIR/setupvars.sh
+export LIBTORCH_ROOTDIR=$LIBTORCH_DIR
+export WHISPERCPP_ROOTDIR=$WHISPER_BUILD_DIR/installed
+export LD_LIBRARY_PATH=${WHISPERCPP_ROOTDIR}/lib:$LD_LIBRARY_PATH
+
+
+echo $OPENVIVO_TOOLKIT_DIR
+echo $LIBTORCH_ROOTDIR
+echo $WHISPERCPP_ROOTDIR
+
+cd $CURRENT_DIR
